# Copy to deploy/.env and replace every placeholder.
TZ=Asia/Shanghai

# Pin this to a tested tag or digest for the real VPS deployment.
# Until the first Cashbook release is validated, upstream latest remains the bootstrap default.
CASHBOOK_CLOUD_IMAGE=sunxiao0721/beecount-cloud:latest

# Default is localhost only. Change only if you intentionally expose port 8869.
CASHBOOK_BIND=127.0.0.1

# Use your own private admin account.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# At least 32 random bytes. scripts/server-init.sh can generate one.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional encrypted-backup passphrase file.
# Keep the actual passphrase OUTSIDE the repository and outside this .env.
# Example setup:
#   mkdir -p /root/.config/cashbook
#   openssl rand -base64 48 > /root/.config/cashbook/backup-passphrase
#   chmod 600 /root/.config/cashbook/backup-passphrase
# CASHBOOK_BACKUP_PASSPHRASE_FILE=/root/.config/cashbook/backup-passphrase
