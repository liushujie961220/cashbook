# Copy to deploy/.env and replace every placeholder.
TZ=Asia/Shanghai

# Default is localhost only. Change only if you intentionally expose port 8869.
CASHBOOK_BIND=127.0.0.1

# Use your own private admin account.
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# At least 32 random bytes. scripts/server-init.sh can generate one.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
